#!/bin/sh
# AppImage entrypoint — same ADBC driver-path wiring as nexusflow-wrapper.sh
# (deb/rpm), but relative to $APPDIR since an AppImage has no fixed install
# prefix (it can run from anywhere, unmounted into a temp dir at launch).
HERE="$(dirname "$(readlink -f "$0")")"
export ADBC_DRIVER_POSTGRESQL_PATH="${ADBC_DRIVER_POSTGRESQL_PATH:-$HERE/usr/lib/libadbc_driver_postgresql.so}"
export ADBC_DRIVER_SQLITE_PATH="${ADBC_DRIVER_SQLITE_PATH:-$HERE/usr/lib/libadbc_driver_sqlite.so}"
export ADBC_DRIVER_CLICKHOUSE_PATH="${ADBC_DRIVER_CLICKHOUSE_PATH:-$HERE/usr/lib/libadbc_clickhouse.so}"
export ADBC_DRIVER_DUCKDB_PATH="${ADBC_DRIVER_DUCKDB_PATH:-$HERE/usr/lib/libadbc_driver_duckdb.so}"
# Bundled, self-contained CPython (scripts/build-python-runtime.sh) — the
# `python-transform`/`dbt` features shell out to a bare `python3`/`dbt` on
# PATH (nexus-server's python_transform.rs/dbt.rs), so prepending this
# tree's own bin/ ahead of everything else means those features work with
# no python/dbt install on the host at all, and never pick up a stray
# system python3 that happens to be on PATH instead.
if [ -d "$HERE/usr/lib/nexusflow/python/bin" ]; then
  export PATH="$HERE/usr/lib/nexusflow/python/bin:$PATH"
fi
exec "$HERE/usr/bin/nexusflow-bin" "$@"
